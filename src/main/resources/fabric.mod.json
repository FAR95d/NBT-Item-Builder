{
	"schemaVersion": 1,
	"id": "nbtitembuilder",
	"version": "${version}",
	"name": "NBT Item Builder",
	"description": "Build items with custom names, lore, enchantments, attributes and container contents in an in-game screen, then give them to yourself.",
	"icon": "assets/nbtitembuilder/icon.png",
	"authors": [
		"NBT Item Builder"
	],
	"license": "MIT",
	"environment": "client",
	"entrypoints": {
		"client": [
			"dev.nbtitembuilder.NbtItemBuilderClient"
		]
	},
	"depends": {
		"fabricloader": ">=0.19.5",
		"minecraft": ${mcDepends},
		"java": ">=${javaVersion}",
		"fabric-api": "*"
	}
}
